{
  "name": "pocket-civilization",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/build-offline.mjs",
    "format": "prettier --write src tests e2e scripts *.ts *.json *.md index.html",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:offline": "playwright test --config playwright.production.config.ts",
    "build:android": "npm run build && python3 scripts/build-android.py"
  },
  "dependencies": {
    "pixi.js": "^8.13.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
